generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @default(uuid())
  first_name String
  last_name  String?
  mobile     String? @unique

  email    String
  password String

  is_email_verified Boolean @default(false)

  @@index([email])
}
